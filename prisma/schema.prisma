// =====================================================
// Quiniela PADELBOX — Prisma Schema
// =====================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_URL_UNPOOLED")
}

// -----------------------------------------------------
// Enums
// -----------------------------------------------------
enum Role {
  USER
  ADMIN
}

enum MatchStatus {
  SCHEDULED
  LIVE
  FINISHED
  POSTPONED
  CANCELLED
}

enum Stage {
  GROUP
  R32
  R16
  QF
  SF
  THIRD
  FINAL
}

// -----------------------------------------------------
// Auth — NextAuth/Auth.js (Prisma adapter)
// -----------------------------------------------------
model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// -----------------------------------------------------
// Dominio Quiniela
// -----------------------------------------------------
model User {
  id               String    @id @default(cuid())
  email            String    @unique
  emailVerified    DateTime?
  name             String?
  image            String?
  role             Role      @default(USER)

  // Pago off-platform — el admin lo marca a mano
  hasPaid          Boolean   @default(false)
  paidAt           DateTime?
  paidNote         String?

  // Pick de campeón del Mundial (bonus +25 pts)
  championPick     String?
  championLockedAt DateTime?

  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  accounts         Account[]
  sessions         Session[]
  predictions      Prediction[]

  @@index([role])
  @@index([hasPaid])
}

model Match {
  id            String      @id @default(cuid())
  apiFootballId Int         @unique
  stage         Stage
  group         String?     // "A".."H" en fase de grupos
  kickoff       DateTime
  homeTeam      String
  awayTeam      String
  homeFlag      String?
  awayFlag      String?
  homeScore     Int?
  awayScore     Int?
  status        MatchStatus @default(SCHEDULED)
  lockedAt      DateTime?   // momento real de cierre
  scoredAt      DateTime?   // momento real de cálculo de puntos

  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  predictions   Prediction[]

  @@index([kickoff])
  @@index([status])
  @@index([stage])
}

model Prediction {
  id        String   @id @default(cuid())
  userId    String
  matchId   String
  homeScore Int
  awayScore Int
  points    Int?     // null hasta que se calcula

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  match Match @relation(fields: [matchId], references: [id], onDelete: Cascade)

  @@unique([userId, matchId])
  @@index([matchId])
  @@index([userId])
}

// Singleton (siempre id=1)
model Rules {
  id                Int       @id @default(1)
  pointsExact       Int       @default(3)
  pointsWinner      Int       @default(1)
  pointsChampion    Int       @default(25)
  lockOffsetMin     Int       @default(15)
  tournamentStartAt DateTime?
  updatedAt         DateTime  @updatedAt
}
