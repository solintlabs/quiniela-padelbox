// =====================================================
// Quiniela PADELBOX — Prisma Schema
// =====================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_URL_UNPOOLED")
}

// -----------------------------------------------------
// Enums
// -----------------------------------------------------
enum Role {
  USER
  ADMIN
}

enum MatchStatus {
  SCHEDULED
  LIVE
  FINISHED
  POSTPONED
  CANCELLED
}

enum Stage {
  GROUP
  R32
  R16
  QF
  SF
  THIRD
  FINAL
}

// -----------------------------------------------------
// Auth — NextAuth/Auth.js (Prisma adapter)
// -----------------------------------------------------
model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// -----------------------------------------------------
// Dominio Quiniela
// -----------------------------------------------------
model User {
  id               String    @id @default(cuid())
  email            String    @unique
  emailVerified    DateTime?
  name             String?
  phone            String?
  image            String?
  role             Role      @default(USER)

  // Pago off-platform — el admin lo marca a mano
  hasPaid          Boolean   @default(false)
  paidAt           DateTime?
  paidNote         String?
  paidMethod       String?   // p.ej. "Pago Móvil", "Zelle", etc. (free text para no acoplarse al id de PaymentMethod)
  paidAmount       String?   // string para permitir "10 USD", "Bs 350", etc.

  // Pick de campeón del Mundial (bonus +25 pts)
  championPick     String?
  championLockedAt DateTime?

  // Enlace de acceso permanente (para gente sin email / poco tecnologica).
  // El admin lo genera; quien tenga el link entra directo a ESTA cuenta.
  // Revocable regenerandolo. Null = sin link activo.
  accessToken      String?   @unique

  // Snapshot de la posicion en el ranking para mostrar flechas de movimiento
  // (subio/bajo X puestos). Lo captura el cron diario (~1x/dia). Null = aun
  // sin snapshot (se muestra sin flecha, "nuevo").
  lastRank         Int?
  lastRankAt       DateTime?

  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  accounts         Account[]
  sessions         Session[]
  predictions      Prediction[]
  pushDevices      PushDevice[]
  predictionLogs   PredictionLog[]

  @@index([role])
  @@index([hasPaid])
}

// Token Expo push por dispositivo. Un user puede tener varios (iPhone + iPad,
// etc). Limpiamos cuando Expo devuelve DeviceNotRegistered.
// =====================================================
// SaaS multi-tenant (Phase B — SCAFFOLDING)
// =====================================================
// IMPORTANTE: estos modelos NO afectan al schema actual de PADELBOX.
// Son tablas independientes (sin FK a User/Match/etc). Permite construir
// la SaaS en paralelo sin romper la quiniela actual.
// Cuando estemos listos para activar multi-tenant real, se añadirá
// `tenantId` a User/Match/Prediction/Sponsor/PaymentMethod/Rules en
// migración separada.

enum TenantStatus {
  LEAD          // Llenó el form pero no pagó aún
  TRIAL         // Pagó/se registró, está en trial
  ACTIVE        // Suscripción activa
  PAYMENT_FAILED
  SUSPENDED
  CANCELLED
}

enum TenantPlan {
  FREE   // 30 días trial
  PRO    // $29/mes (placeholder)
  CUSTOM // White-label, agencia
}

model Tenant {
  id              String       @id @default(cuid())
  slug            String       @unique          // "padelbox", "miclub" → subdominio
  name            String                        // "Club PADELBOX"
  adminEmail      String                        // email del primer admin
  adminPhone      String?
  logoUrl         String?
  accentColor     String       @default("#B6FF3C")
  contactWhatsapp String?
  prizesText      String?                       // premios de la quiniela (texto libre, multilínea)
  status          TenantStatus @default(LEAD)
  plan            TenantPlan   @default(FREE)
  trialEndsAt     DateTime?
  stripeCustomerId String?
  stripeSubId     String?
  // Idioma por defecto del comercio. El usuario puede sobreescribirlo;
  // prioridad final: usuario > tenant > dispositivo (Fase 6).
  defaultLocale   String       @default("es")
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  memberships  SaasMembership[]
  competitions SaasCompetition[]

  @@index([status])
  @@index([slug])
}

// Lead capture: quien rellena "quiero mi quiniela" sin completar onboarding.
model Lead {
  id           String   @id @default(cuid())
  email        String
  name         String?
  clubName     String?
  phone        String?
  expectedSize Int?     // socios esperados
  source       String?  // "login_cta", "dashboard_cta", "landing", etc.
  notes        String?
  contacted    Boolean  @default(false)
  createdAt    DateTime @default(now())

  @@index([contacted, createdAt])
}

// Rate limit por bucket (userId+action o ip+action).
// Borrar registros antiguos por TTL de cron diario.
model RateLimit {
  key       String   @id          // ej "predict:user:abc123" o "predict:ip:1.2.3.4"
  count     Int      @default(0)
  windowEnd DateTime              // fin del bucket actual
  updatedAt DateTime @updatedAt

  @@index([windowEnd])
}

model PushDevice {
  id          String   @id @default(cuid())
  userId      String
  expoToken   String   @unique
  platform    String   // "ios" | "android"
  appVersion  String?
  lastUsedAt  DateTime @default(now())
  createdAt   DateTime @default(now())

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Match {
  id            String      @id @default(cuid())
  externalId    Int         @unique     // id del proveedor (ESPN event.id)
  stage         Stage
  group         String?     // "A".."H" en fase de grupos
  kickoff       DateTime
  homeTeam      String
  awayTeam      String
  homeFlag      String?
  awayFlag      String?
  // Marcador que CUENTA para los puntos = resultado a los 90 min (reglamentario).
  // En grupos = resultado final. En eliminatorias con prórroga, es el de los 90'.
  homeScore     Int?
  awayScore     Int?
  // Marcador FINAL con prórroga/penales (solo para MOSTRAR). Null si no hubo
  // prórroga (entonces final = 90 min y se muestra homeScore/awayScore).
  finalHomeScore Int?
  finalAwayScore Int?
  // Estadio y ciudad ("Estadio Azteca · Mexico City"). Lo trae ESPN en cada sync.
  venue         String?
  status        MatchStatus @default(SCHEDULED)
  lockedAt      DateTime?   // momento real de cierre
  scoredAt      DateTime?   // momento real de cálculo de puntos
  // Marcado cuando se envió el push "recordatorio 1h antes" (evita doble envio)
  reminderSentAt DateTime?
  // Marcado cuando se envió el push "última llamada" (pocos min antes del cierre)
  lastCallSentAt DateTime?
  // Si true: este match NO entra en scoring (ni lockAndScore ni recomputeAll
  // ni en el ranking). Usado por admin para "Resetear puntuaciones" antes
  // del Mundial sin perder los partidos como historico.
  excludeFromScoring Boolean @default(false)

  // Si true: el sync con ESPN NO sobrescribe marcador/estado de este match.
  // Usado en eliminatorias para fijar el resultado de 90 min a mano (ESPN
  // reporta el resultado final con prorroga). El admin lo activa al editar.
  manualResult       Boolean @default(false)

  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  predictions   Prediction[]
  predictionLogs PredictionLog[]

  @@index([kickoff])
  @@index([status])
  @@index([stage])
}

model Prediction {
  id        String   @id @default(cuid())
  userId    String
  matchId   String
  homeScore Int
  awayScore Int
  points    Int?     // null hasta que se calcula

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  match Match @relation(fields: [matchId], references: [id], onDelete: Cascade)

  @@unique([userId, matchId])
  @@index([matchId])
  @@index([userId])
}

// Historial de cambios de predicciones (auditoría). Cada guardado que CAMBIA
// algo escribe una entrada con el valor anterior — el admin ve qué cambió
// cada jugador y cuándo (p.ej. para evaluar si la barra de % influye).
model PredictionLog {
  id        String   @id @default(cuid())
  userId    String
  matchId   String
  homeScore Int
  awayScore Int
  // Valor anterior (null = primera predicción de ese user para ese match)
  prevHome  Int?
  prevAway  Int?
  createdAt DateTime @default(now())

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  match Match @relation(fields: [matchId], references: [id], onDelete: Cascade)

  @@index([createdAt])
  @@index([userId, createdAt])
  @@index([matchId, createdAt])
}

// Estado de avisos push por ronda de eliminatorias (una fila por stage).
// Evita duplicar el aviso de "ronda desbloqueada", controla el recordatorio
// cada 2h y el aviso "antes de cerrar". Lo gestiona el cron (lib/sync.ts).
model KnockoutNotice {
  stage          String    @id   // 'R32' | 'R16' | 'QF' | 'SF' | 'THIRD' | 'FINAL'
  unlockSentAt   DateTime?       // aviso "ya se abrio la ronda"
  lastRemindAt   DateTime?       // ultimo recordatorio cada 2h
  preCloseSentAt DateTime?       // aviso "cierra pronto el primer partido"
  updatedAt      DateTime  @updatedAt
}

// Singleton (siempre id=1)
model Rules {
  id                Int       @id @default(1)
  pointsExact       Int       @default(3)
  pointsWinner      Int       @default(1)
  pointsChampion    Int       @default(25)
  lockOffsetMin     Int       @default(15)
  tournamentStartAt DateTime?
  // Cuota y bote
  feeAmount         Int       @default(10)        // valor numérico (10, 25, 100...)
  feeCurrency       String    @default("USD")     // "USD", "EUR", "VES"...
  // Modo manual: si está activo, syncMatchesFromApi no toca la DB.
  // Para cuando ESPN cae y el admin gestiona partidos a mano sin que el
  // cron sobreescriba las ediciones manuales.
  syncPaused        Boolean   @default(false)
  // Premios de la semana (free text editado por admin). Aparece en dashboard.
  // Vacio o null = no se muestra el bloque.
  weeklyPrizesText  String?
  // Premios del campeonato completo (texto libre). El admin lo edita y
  // aparece en el dashboard de la app movil. Si vacio, dashboard muestra
  // version generica "Premio mayor del podio" (Apple-safe).
  championPrizesText String?
  // Campeón ganador del torneo (lo setea el admin cuando termina la final).
  // Usado para otorgar el bonus de pointsChampion en el ranking final.
  championWinner    String?
  // Fecha y hora a partir de la cual no se aceptan nuevas inscripciones ni
  // marcar como pagado. Si es null, las inscripciones quedan abiertas para
  // siempre. El admin lo edita desde /admin/reglas.
  inscriptionsCloseAt DateTime?
  // Si true: la pagina /ranking publica muestra un placeholder en vez de la
  // lista de participantes. Util cuando hay poca gente inscrita y no se
  // quiere mostrar "solo 4 personas" como senal social negativa.
  rankingHidden     Boolean   @default(false)
  // Texto que se muestra en /ranking cuando rankingHidden=true. Si null,
  // usa el copy default. Editable desde /admin/reglas.
  rankingHiddenText String?
  // Si true: al cerrar cada partido, los usuarios pagados que NO hayan
  // pronosticado reciben un 0-0 automático (red de seguridad para que nadie
  // se quede sin marcador). El admin lo activa en /admin/reglas.
  autofillZeroOnLock Boolean  @default(false)
  // Último envío del recordatorio DIARIO (resumen "te faltan N partidos"),
  // para no mandar más de uno al día (antes se mandaba uno por partido = spam).
  lastDigestAt      DateTime?
  // Si true: se muestra la barra "Cómo predicen" (% gana local / empate /
  // visitante agregado) en cada partido, en web y app. Toggle en /admin/reglas.
  showDistribution  Boolean   @default(true)
  updatedAt         DateTime  @updatedAt
}

// Gift cards emitidas como premios (verificables por los locales).
// El admin las emite desde /admin/giftcards; el local escanea el QR o entra
// a /gift/[code] para comprobar que es real y no está canjeada.
// status: "ACTIVE" | "REDEEMED" | "VOID" (string simple, sin enum).
model GiftCard {
  id          String    @id @default(cuid())
  code        String    @unique   // "QB-XXXX-XXXX" — impreso en la tarjeta
  monto       String
  titulo      String?
  detalle     String?
  sponsorName String?
  winnerName  String?
  status      String    @default("ACTIVE")
  redeemedAt  DateTime?
  redeemNote  String?
  createdAt   DateTime  @default(now())

  @@index([status, createdAt])
}

// Patrocinadores del bote — opcional. Se muestran en login y dashboard.
model Sponsor {
  id        String   @id @default(cuid())
  tenantId  String?
  name      String
  logoUrl   String?
  url       String?
  enabled   Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId, enabled, sortOrder])
}

// Premios semanales — uno por cada semana del torneo que el admin decida premiar.
// La semana 1 va del día de arranque al domingo siguiente; las siguientes son
// Lunes-Domingo completas. Si el admin no crea entrada para una semana, esa
// semana no muestra premio (es opcional). Ver lib/weeks.ts para el cálculo.
model WeeklyPrize {
  id            String    @id @default(cuid())
  weekNumber    Int       @unique  // 1, 2, 3, ...
  prizeText     String              // texto libre con emojis, ej "🍔 1er lugar: Combo DELISH"
  winnerUserId  String?             // admin marca ganador al cerrar la semana
  awardedAt     DateTime?           // cuándo se otorgó (sello temporal)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

// =====================================================
// SaaS multi-tenant — tablas propias (Fase 1)
// =====================================================
// REGLA: toda tabla del SaaS empieza por `Saas`. Ninguna tiene FK ni relación
// hacia los modelos de PADELBOX (User, Match, Prediction, Rules...), así que
// la quiniela actual no cambia de comportamiento ni de forma.
//
// El único puente con el mundo viejo es `SaasMembership.userId`, que guarda un
// `User.id` como String suelto, SIN relation de Prisma: así un organizador
// entra con el mismo magic link de siempre y el modelo `User` no se toca.
// El precio es que no hay cascade automático — al borrar un usuario hay que
// limpiar sus memberships en código (lib/saas/memberships.ts).

enum SaasRole {
  OWNER   // creó el tenant, único que toca facturación
  ADMIN   // gestiona la competición y los jugadores
  PLAYER  // solo pronostica
}

enum SaasProvider {
  ESPN
  MANUAL
}

enum SaasCompetitionFormat {
  LEAGUE     // liga regular (jornadas)
  GROUPS_KO  // grupos + eliminatorias (tipo Mundial)
  KO         // solo eliminatorias
  CUSTOM
}

enum SaasCompetitionStatus {
  DRAFT     // el organizador la está montando, invisible para jugadores
  OPEN      // admite pronósticos; la sincroniza el cron
  LOCKED    // cerrada a nuevos pronósticos, aún se puntúa
  FINISHED
}

enum SaasFixtureStatus {
  SCHEDULED
  LIVE
  FINISHED
  POSTPONED
  CANCELLED
}

// Usuario ↔ tenant. Un mismo email puede ser OWNER de su club y PLAYER en el
// club de otro sin duplicar cuenta.
model SaasMembership {
  id       String   @id @default(cuid())
  tenantId String
  userId   String   // -> User.id (sin relation, ver nota de arriba)
  role     SaasRole @default(PLAYER)

  // Pago off-platform del jugador al organizador (el bote del club).
  // Equivalente por tenant a User.hasPaid, que sigue siendo solo de PADELBOX.
  hasPaid  Boolean   @default(false)
  paidAt   DateTime?
  paidNote String?

  // Nombre elegido para ESTE tenant. Null = se usa el del User.
  displayName String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant        Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  entries       SaasEntry[]
  championPicks SaasChampionPick[]

  @@unique([tenantId, userId])
  @@index([userId])
  @@index([tenantId, role])
}

// Competición de un tenant. Cada una lleva SU config de puntos: aquí no hay
// singleton global equivalente a Rules.
model SaasCompetition {
  id       String @id @default(cuid())
  tenantId String
  name     String
  sport    String @default("soccer")

  provider SaasProvider @default(MANUAL)
  espnSlug String?      // "esp.1", "fifa.world"... verificado contra {core}/leagues
  season   String?

  format SaasCompetitionFormat @default(LEAGUE)
  status SaasCompetitionStatus @default(DRAFT)

  // -------- Puntuación, a gusto del organizador --------
  // El núcleo (exacto / ganador) reusa la fórmula pura de lib/scoring.ts.
  // Los extras son aditivos y vienen a 0 = desactivados, así que una
  // competición recién creada puntúa igual que PADELBOX (3/1/0).
  //
  // El marcador exacto es EXCLUYENTE: quien lo acierta se lleva pointsExact y
  // no acumula los parciales, o acertar de pleno pagaría menos que fallar
  // con estilo.
  pointsExact     Int @default(3) // marcador clavado
  pointsWinner    Int @default(1) // acertar 1X2
  pointsGoalDiff  Int @default(0) // acertar la diferencia de goles
  pointsTeamScore Int @default(0) // por cada equipo cuyo marcador aciertas
  pointsDrawBonus Int @default(0) // extra por clavar un empate (es más difícil)
  // Reservado para el pick de campeón del torneo (equivalente al +25 de
  // PADELBOX). Se aplicará en el panel del organizador, aún sin usar.
  pointsBonus     Int @default(0)
  lockOffsetMin   Int @default(15)

  // Equipo campeón del torneo. Lo fija el organizador al terminar; quien lo
  // acertó en su pick de campeón se lleva pointsBonus. Sin FK dura para no
  // bloquear el borrado de un equipo.
  championWinnerTeamId String?

  lastSyncedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant        Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  teams         SaasTeam[]
  fixtures      SaasFixture[]
  championPicks SaasChampionPick[]

  @@index([tenantId, status])
  @@index([status, provider])
}

// Equipos de una competición (importados de ESPN o creados a mano).
model SaasTeam {
  id            String  @id @default(cuid())
  competitionId String
  name          String
  shortName     String?
  logoUrl       String?
  espnId        String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  competition   SaasCompetition    @relation(fields: [competitionId], references: [id], onDelete: Cascade)
  homeFixtures  SaasFixture[]      @relation("SaasFixtureHome")
  awayFixtures  SaasFixture[]      @relation("SaasFixtureAway")
  championPicks SaasChampionPick[]

  @@unique([competitionId, name])
  @@unique([competitionId, espnId])
  @@index([competitionId])
}

// Pick de campeón del torneo por jugador. Se congela cuando arranca el primer
// partido de la competición. Si el pick coincide con championWinnerTeamId, el
// jugador suma pointsBonus. Equivalente al +25 de PADELBOX pero por competición.
model SaasChampionPick {
  id            String @id @default(cuid())
  membershipId  String
  competitionId String
  teamId        String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  membership  SaasMembership  @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  competition SaasCompetition @relation(fields: [competitionId], references: [id], onDelete: Cascade)
  team        SaasTeam        @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@unique([membershipId, competitionId])
  @@index([competitionId])
}

// Partido de una competición.
model SaasFixture {
  id            String @id @default(cuid())
  competitionId String
  homeTeamId    String
  awayTeamId    String

  kickoff DateTime
  // Texto libre de la fase: "Jornada 12", "Grupo A", "Octavos".
  round   String?

  homeScore Int?
  awayScore Int?
  status    SaasFixtureStatus @default(SCHEDULED)

  lockedAt DateTime?
  scoredAt DateTime?

  source     SaasProvider @default(MANUAL)
  externalId String?      // ESPN event.id
  // Si true, el sync del proveedor NO pisa marcador ni estado (edición manual).
  manualResult Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  competition SaasCompetition @relation(fields: [competitionId], references: [id], onDelete: Cascade)
  homeTeam    SaasTeam        @relation("SaasFixtureHome", fields: [homeTeamId], references: [id], onDelete: Cascade)
  awayTeam    SaasTeam        @relation("SaasFixtureAway", fields: [awayTeamId], references: [id], onDelete: Cascade)
  entries     SaasEntry[]

  @@unique([competitionId, externalId])
  @@index([competitionId, kickoff])
  @@index([status])
}

// Pronóstico de un jugador para un partido. Cuelga de la membership, no del
// User: así un pronóstico siempre pertenece a un tenant concreto.
model SaasEntry {
  id           String @id @default(cuid())
  membershipId String
  fixtureId    String
  homeScore    Int
  awayScore    Int
  points       Int?   // null hasta que el scoring lo calcula

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  membership SaasMembership @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  fixture    SaasFixture    @relation(fields: [fixtureId], references: [id], onDelete: Cascade)

  @@unique([membershipId, fixtureId])
  @@index([fixtureId])
}

// Métodos de pago configurables desde /admin/pagos.
// En la fase SaaS multi-tenant se añadirá tenantId (por ahora null = global).
model PaymentMethod {
  id        String   @id @default(cuid())
  tenantId  String?
  enabled   Boolean  @default(true)
  sortOrder Int      @default(0)
  type      String   // "pago_movil" | "bank_transfer" | "zelle" | "binance" | "other"
  title     String   // "Pago Móvil"
  subtitle  String?  // "Banesco"
  icon      String?  // emoji p.ej. "📲"
  fields    Json     // [{ label, value, mono?: boolean }]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId, enabled, sortOrder])
}
