// =====================================================
// Quiniela PADELBOX — Prisma Schema
// =====================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_URL_UNPOOLED")
}

// -----------------------------------------------------
// Enums
// -----------------------------------------------------
enum Role {
  USER
  ADMIN
}

enum MatchStatus {
  SCHEDULED
  LIVE
  FINISHED
  POSTPONED
  CANCELLED
}

enum Stage {
  GROUP
  R32
  R16
  QF
  SF
  THIRD
  FINAL
}

// -----------------------------------------------------
// Auth — NextAuth/Auth.js (Prisma adapter)
// -----------------------------------------------------
model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// -----------------------------------------------------
// Dominio Quiniela
// -----------------------------------------------------
model User {
  id               String    @id @default(cuid())
  email            String    @unique
  emailVerified    DateTime?
  name             String?
  phone            String?
  image            String?
  role             Role      @default(USER)

  // Pago off-platform — el admin lo marca a mano
  hasPaid          Boolean   @default(false)
  paidAt           DateTime?
  paidNote         String?
  paidMethod       String?   // p.ej. "Pago Móvil", "Zelle", etc. (free text para no acoplarse al id de PaymentMethod)
  paidAmount       String?   // string para permitir "10 USD", "Bs 350", etc.

  // Pick de campeón del Mundial (bonus +25 pts)
  championPick     String?
  championLockedAt DateTime?

  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  accounts         Account[]
  sessions         Session[]
  predictions      Prediction[]
  pushDevices      PushDevice[]

  @@index([role])
  @@index([hasPaid])
}

// Token Expo push por dispositivo. Un user puede tener varios (iPhone + iPad,
// etc). Limpiamos cuando Expo devuelve DeviceNotRegistered.
// =====================================================
// SaaS multi-tenant (Phase B — SCAFFOLDING)
// =====================================================
// IMPORTANTE: estos modelos NO afectan al schema actual de PADELBOX.
// Son tablas independientes (sin FK a User/Match/etc). Permite construir
// la SaaS en paralelo sin romper la quiniela actual.
// Cuando estemos listos para activar multi-tenant real, se añadirá
// `tenantId` a User/Match/Prediction/Sponsor/PaymentMethod/Rules en
// migración separada.

enum TenantStatus {
  LEAD          // Llenó el form pero no pagó aún
  TRIAL         // Pagó/se registró, está en trial
  ACTIVE        // Suscripción activa
  PAYMENT_FAILED
  SUSPENDED
  CANCELLED
}

enum TenantPlan {
  FREE   // 30 días trial
  PRO    // $29/mes (placeholder)
  CUSTOM // White-label, agencia
}

model Tenant {
  id              String       @id @default(cuid())
  slug            String       @unique          // "padelbox", "miclub" → subdominio
  name            String                        // "Club PADELBOX"
  adminEmail      String                        // email del primer admin
  adminPhone      String?
  logoUrl         String?
  accentColor     String       @default("#B6FF3C")
  contactWhatsapp String?
  status          TenantStatus @default(LEAD)
  plan            TenantPlan   @default(FREE)
  trialEndsAt     DateTime?
  stripeCustomerId String?
  stripeSubId     String?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  @@index([status])
  @@index([slug])
}

// Lead capture: quien rellena "quiero mi quiniela" sin completar onboarding.
model Lead {
  id           String   @id @default(cuid())
  email        String
  name         String?
  clubName     String?
  phone        String?
  expectedSize Int?     // socios esperados
  source       String?  // "login_cta", "dashboard_cta", "landing", etc.
  notes        String?
  contacted    Boolean  @default(false)
  createdAt    DateTime @default(now())

  @@index([contacted, createdAt])
}

// Rate limit por bucket (userId+action o ip+action).
// Borrar registros antiguos por TTL de cron diario.
model RateLimit {
  key       String   @id          // ej "predict:user:abc123" o "predict:ip:1.2.3.4"
  count     Int      @default(0)
  windowEnd DateTime              // fin del bucket actual
  updatedAt DateTime @updatedAt

  @@index([windowEnd])
}

model PushDevice {
  id          String   @id @default(cuid())
  userId      String
  expoToken   String   @unique
  platform    String   // "ios" | "android"
  appVersion  String?
  lastUsedAt  DateTime @default(now())
  createdAt   DateTime @default(now())

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Match {
  id            String      @id @default(cuid())
  externalId    Int         @unique     // id del proveedor (ESPN event.id)
  stage         Stage
  group         String?     // "A".."H" en fase de grupos
  kickoff       DateTime
  homeTeam      String
  awayTeam      String
  homeFlag      String?
  awayFlag      String?
  homeScore     Int?
  awayScore     Int?
  status        MatchStatus @default(SCHEDULED)
  lockedAt      DateTime?   // momento real de cierre
  scoredAt      DateTime?   // momento real de cálculo de puntos
  // Marcado cuando se envió el push "recordatorio 1h antes" (evita doble envio)
  reminderSentAt DateTime?
  // Si true: este match NO entra en scoring (ni lockAndScore ni recomputeAll
  // ni en el ranking). Usado por admin para "Resetear puntuaciones" antes
  // del Mundial sin perder los partidos como historico.
  excludeFromScoring Boolean @default(false)

  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  predictions   Prediction[]

  @@index([kickoff])
  @@index([status])
  @@index([stage])
}

model Prediction {
  id        String   @id @default(cuid())
  userId    String
  matchId   String
  homeScore Int
  awayScore Int
  points    Int?     // null hasta que se calcula

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  match Match @relation(fields: [matchId], references: [id], onDelete: Cascade)

  @@unique([userId, matchId])
  @@index([matchId])
  @@index([userId])
}

// Singleton (siempre id=1)
model Rules {
  id                Int       @id @default(1)
  pointsExact       Int       @default(3)
  pointsWinner      Int       @default(1)
  pointsChampion    Int       @default(25)
  lockOffsetMin     Int       @default(15)
  tournamentStartAt DateTime?
  // Cuota y bote
  feeAmount         Int       @default(10)        // valor numérico (10, 25, 100...)
  feeCurrency       String    @default("USD")     // "USD", "EUR", "VES"...
  // Modo manual: si está activo, syncMatchesFromApi no toca la DB.
  // Para cuando ESPN cae y el admin gestiona partidos a mano sin que el
  // cron sobreescriba las ediciones manuales.
  syncPaused        Boolean   @default(false)
  // Premios de la semana (free text editado por admin). Aparece en dashboard.
  // Vacio o null = no se muestra el bloque.
  weeklyPrizesText  String?
  // Premios del campeonato completo (texto libre). El admin lo edita y
  // aparece en el dashboard de la app movil. Si vacio, dashboard muestra
  // version generica "Premio mayor del podio" (Apple-safe).
  championPrizesText String?
  // Campeón ganador del torneo (lo setea el admin cuando termina la final).
  // Usado para otorgar el bonus de pointsChampion en el ranking final.
  championWinner    String?
  // Fecha y hora a partir de la cual no se aceptan nuevas inscripciones ni
  // marcar como pagado. Si es null, las inscripciones quedan abiertas para
  // siempre. El admin lo edita desde /admin/reglas.
  inscriptionsCloseAt DateTime?
  // Si true: la pagina /ranking publica muestra un placeholder en vez de la
  // lista de participantes. Util cuando hay poca gente inscrita y no se
  // quiere mostrar "solo 4 personas" como senal social negativa.
  rankingHidden     Boolean   @default(false)
  // Texto que se muestra en /ranking cuando rankingHidden=true. Si null,
  // usa el copy default. Editable desde /admin/reglas.
  rankingHiddenText String?
  updatedAt         DateTime  @updatedAt
}

// Patrocinadores del bote — opcional. Se muestran en login y dashboard.
model Sponsor {
  id        String   @id @default(cuid())
  tenantId  String?
  name      String
  logoUrl   String?
  url       String?
  enabled   Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId, enabled, sortOrder])
}

// Premios semanales — uno por cada semana del torneo que el admin decida premiar.
// La semana 1 va del día de arranque al domingo siguiente; las siguientes son
// Lunes-Domingo completas. Si el admin no crea entrada para una semana, esa
// semana no muestra premio (es opcional). Ver lib/weeks.ts para el cálculo.
model WeeklyPrize {
  id            String    @id @default(cuid())
  weekNumber    Int       @unique  // 1, 2, 3, ...
  prizeText     String              // texto libre con emojis, ej "🍔 1er lugar: Combo DELISH"
  winnerUserId  String?             // admin marca ganador al cerrar la semana
  awardedAt     DateTime?           // cuándo se otorgó (sello temporal)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

// Métodos de pago configurables desde /admin/pagos.
// En la fase SaaS multi-tenant se añadirá tenantId (por ahora null = global).
model PaymentMethod {
  id        String   @id @default(cuid())
  tenantId  String?
  enabled   Boolean  @default(true)
  sortOrder Int      @default(0)
  type      String   // "pago_movil" | "bank_transfer" | "zelle" | "binance" | "other"
  title     String   // "Pago Móvil"
  subtitle  String?  // "Banesco"
  icon      String?  // emoji p.ej. "📲"
  fields    Json     // [{ label, value, mono?: boolean }]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId, enabled, sortOrder])
}
