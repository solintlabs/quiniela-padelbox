# =====================================================
# Quiniela PADELBOX — variables de entorno
# Copia este archivo como .env.local y rellena los valores
# =====================================================

# -----------------------------------------------------
# Database (Neon Postgres via Vercel Marketplace)
# Estas variables las inyecta Vercel automáticamente al
# conectar Neon desde Storage → Marketplace.
# -----------------------------------------------------
# Connection con pooler (uso normal de la app)
DATABASE_URL="postgresql://user:pass@host-pooler.region.aws.neon.tech/db?sslmode=require"
# Connection directa sin pooler (migraciones Prisma)
DATABASE_URL_UNPOOLED="postgresql://user:pass@host.region.aws.neon.tech/db?sslmode=require"

# -----------------------------------------------------
# NextAuth / Auth.js v5
# -----------------------------------------------------
# Genera con:  openssl rand -base64 32
AUTH_SECRET=""
# En desarrollo: http://localhost:3000 — en prod: https://quiniela.padelbox.es
AUTH_URL="http://localhost:3000"
# Mantenido por compat con next-auth v4
NEXTAUTH_URL="http://localhost:3000"

# -----------------------------------------------------
# Email — Resend (magic link + notificaciones)
# -----------------------------------------------------
RESEND_API_KEY=""
EMAIL_FROM="Quiniela PADELBOX <quiniela@padelbox.es>"

# -----------------------------------------------------
# Google OAuth (opcional pero recomendado)
# Console: https://console.cloud.google.com/apis/credentials
# Redirect URI:  {AUTH_URL}/api/auth/callback/google
# -----------------------------------------------------
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# -----------------------------------------------------
# API-Football (api-sports.io)
# Free plan: https://www.api-football.com/
# -----------------------------------------------------
API_FOOTBALL_KEY=""
API_FOOTBALL_HOST="v3.football.api-sports.io"
# Liga del Mundial 2026 — ajustar cuando API-Football publique el id oficial
API_FOOTBALL_LEAGUE_ID="1"
API_FOOTBALL_SEASON="2026"

# -----------------------------------------------------
# Cron — Vercel
# Header esperado: Authorization: Bearer ${CRON_SECRET}
# Genera con:  openssl rand -hex 32
# -----------------------------------------------------
CRON_SECRET=""

# -----------------------------------------------------
# Bootstrap
# -----------------------------------------------------
# Email del admin inicial; el seed lo crea con role=ADMIN y hasPaid=true
ADMIN_EMAIL="admin@padelbox.es"
